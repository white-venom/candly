# Copy this file to .env and fill it in. .env is gitignored: never commit real keys, never paste them in chat.

# Data source: auto (Fyers if its keys are set, otherwise the Yahoo dev fallback) | fyers | yahoo
DATA_SOURCE=auto

# --- Fyers API v3: primary market data. Create an app in the Fyers API dashboard (myapi.fyers.in)
# and set its redirect URL to the value of FYERS_REDIRECT_URI below (Fyers rejects localhost/IP URLs).
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=https://trade.fyers.in/api-login/redirect-uri/index.html
# Your Fyers login id
FYERS_CLIENT_ID=
# Optional, only for automatic daily login
FYERS_PIN=
FYERS_TOTP_SECRET=

# --- Kotak Neo: Stage B order execution, backup live feed
KOTAK_CONSUMER_KEY=
KOTAK_CONSUMER_SECRET=
KOTAK_MOBILE=
KOTAK_UCC=
KOTAK_MPIN=
KOTAK_TOTP_SECRET=

# --- Claude API: news tagging and explanations
ANTHROPIC_API_KEY=

# --- Telegram alerts: create a bot with @BotFather, then message it once to get your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
